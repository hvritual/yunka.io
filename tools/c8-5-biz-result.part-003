 (?,?,?)", tenant, user, site)
+	}
+	exec("INSERT IGNORE INTO biz_api_tokens (token_hash,tenant_id,user_id,disabled,created_at) VALUES (?,?,?,?,NOW(3))", accesspersistence.TokenHash(token), tenant, user, false)
+}
