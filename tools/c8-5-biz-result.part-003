 		Devices []map[string]any `json:"devices"`
 	}
-	if err := json.Unmarshal(body, &list); err != nil {
+	if err := json.Unmarshal(body, &out); err != nil {
 		t.Fatal(err)
 	}
-	if len(list.Devices) != 1 || list.Devices[0]["serial"] != "SN-A" {
-		t.Fatalf("reader list=%s", body)
+	return out.Devices
+}
