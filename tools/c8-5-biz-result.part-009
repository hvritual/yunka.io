-		}
-		if err := db.Clauses(clause.OnConflict{DoNothing: true}).Create(&RoleDataScope{TenantID: config.TenantID, RoleID: roleID, Permission: permission, Scope: DataScopeAll}).Error; err != nil {
-			return err
-		}
-	}
-	return nil
-}
diff --git a/internal/deviceops/application/security_boundary_test.go b/internal/deviceops/application/security_boundary_test.go
new file mode 100644
index 0000000..c638740
--- /dev/null
+++ b/internal/deviceops/application/security_boundary_test.go
@@ -0,0 +1,24 @@
+package application
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestApplicationContainsNoAuthorizationPolicy(t *testing.T) {
+	source, err := os.ReadFile("service.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(source)
+	for _, forbidden := range []string{
+		"device.read", "device.create", "device.update", "device.delete",
+		"ResolveGrants", "ResolveDeviceScope", "HasPermissions", "Authorize(",
+		"internal/access", "gateway/authz",
+	} {
+		if strings.Contains(text, forbidden) {
+			t.Fatalf("Application security boundary leak %q in service.go", forbidden)
+		}
+	}
+}
