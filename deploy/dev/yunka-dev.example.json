{
  "schemaVersion": 3,
  "runtime": {
    "application": "yunka-local",
    "statePath": ".yunka/dev-runtime.json",
    "graphPath": ".yunka/runtime-graph.json",
    "contractManifest": "contracts/generated/manifest.json",
    "shutdownTimeout": "15s",
    "closure": true
  },
  "processes": [
    {
      "name": "api",
      "command": ["go", "run", "./cmd/api"],
      "workingDir": "example-service",
      "dependsOn": [],
      "graphNode": "service:example.ApiService",
      "inheritEnv": ["OTEL_EXPORTER_OTLP_ENDPOINT", "YUNKA_DIAGNOSTICS_TOKEN"],
      "readiness": {
        "url": "http://127.0.0.1:16667/_yunka/diagnostics",
        "timeout": "30s",
        "interval": "250ms",
        "expectedStatus": 200,
        "diagnosticsReady": true,
        "captureDiagnostics": true,
        "tokenEnv": "YUNKA_DIAGNOSTICS_TOKEN"
      }
    }
  ]
}
